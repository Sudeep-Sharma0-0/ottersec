digraph "OtterInferenceResult"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="OtterInferenceResult",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Detailed inference telemetry for the Tripwire Control Server."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" detections",fontcolor="grey" ];
  Node2 [id="Node000002",label="OtterDetection",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structOtterDetection.html",tooltip="Represents a tracked person and their skeletal structure."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" keypoints",fontcolor="grey" ];
  Node3 [id="Node000003",label="OtterKeypoint",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structOtterKeypoint.html",tooltip="Represents a single skeletal keypoint (e.g., shoulder, knee)."];
}
